// Prisma schema for the salon scheduling app.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROFESSIONAL
}

enum AppointmentStatus {
  PENDING_PAYMENT
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  OTHER
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           Role          @default(ADMIN)
  professionalId String?       @unique
  professional   Professional? @relation(fields: [professionalId], references: [id])
  createdAt      DateTime      @default(now())
}

model Professional {
  id                String         @id @default(cuid())
  name              String
  color             String         @default("#D946A6")
  phone             String?
  active            Boolean        @default(true)
  commissionPercent Float          @default(0)
  user              User?
  workingHours      WorkingHour[]
  appointments      Appointment[]
  timeBlocks        TimeBlock[]
  createdAt         DateTime       @default(now())
}

model WorkingHour {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int // 0 = domingo ... 6 = sábado
  startTime      String // "09:00"
  endTime        String // "18:00"

  @@unique([professionalId, weekday])
}

model TimeBlock {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  start          DateTime
  end            DateTime
  reason         String?
  createdAt      DateTime     @default(now())
}

model Client {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  email        String?
  birthDate    DateTime?
  notes        String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
}

model Service {
  id              String        @id @default(cuid())
  name            String
  category        String?
  durationMinutes Int           @default(30)
  price           Float         @default(0)
  active          Boolean       @default(true)
  appointments    Appointment[]
  createdAt       DateTime      @default(now())
}

model Appointment {
  id             String            @id @default(cuid())
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id])
  professionalId String
  professional   Professional      @relation(fields: [professionalId], references: [id])
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id])
  start          DateTime
  end            DateTime
  status         AppointmentStatus @default(SCHEDULED)
  price          Float // snapshot of the service price at booking time
  notes          String?
  payments       Payment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Payment {
  id                 String        @id @default(cuid())
  appointmentId      String
  appointment        Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amount             Float
  method             PaymentMethod @default(CASH)
  isDeposit          Boolean       @default(false)
  externalPaymentId  String?       @unique // Mercado Pago payment id, for webhook idempotency
  paidAt             DateTime      @default(now())
}
